# Server only. Never prefix this variable with VITE_.
OPENAI_API_KEY=

# A Responses-compatible model enabled for your project.
OPENAI_BACKEND_MODEL=gpt-5.4-mini

# Sessions end automatically. Valid range: 30–600 seconds.
MAX_SESSION_SECONDS=180

# This sample always binds 127.0.0.1. It does not offer a public-server mode.
PORT=3000
